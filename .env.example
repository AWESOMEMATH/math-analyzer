# 복사해서 Vercel 환경변수(Production)에 넣는다. 이 파일에 실제 값을 쓰지 말 것.
# 임의 문자열 만들기: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# ── 필수 ─────────────────────────────
ANTHROPIC_API_KEY=
# Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 — JSON 파일 내용 전체를 한 줄로
FIREBASE_SERVICE_ACCOUNT=
# 12자 이상
ADMIN_PASSWORD=
# 32자 이상 임의 문자열
PORTAL_SECRET=
# 16자 이상 임의 문자열 — 오픈빌더 스킬 헤더 x-skill-secret 에 같은 값
KAKAO_SKILL_SECRET=
# https://도메인 (끝 / 없이)
PUBLIC_BASE_URL=
# 16자 이상 임의 문자열 — Vercel Cron이 자동으로 Authorization 헤더에 넣는다
CRON_SECRET=

# ── 권장 ─────────────────────────────
KAKAO_CHANNEL_URL=
# 법률 검토 후 입력 (없으면 초안 문구)
CONSENT_OPERATOR=
CONSENT_RETENTION=
CONSENT_CONTACT=

# ── 조정 (기본값) ────────────────────
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium
# KAKAO_MODEL=
# KAKAO_EFFORT=
# KAKAO_DAILY_LIMIT=20
# KAKAO_CALLBACK_DEADLINE_MS=45000
# DIAG_MIN_QUESTIONS=8
# DIAG_MIN_TESTS=2
# PORTAL_LINK_DAYS=7

# ── 선택 ─────────────────────────────
# BRAIN_API_URL=
# BRAIN_API_TOKEN=

# ── 기존 웹 분석기 (/) ───────────────
# INVITE_CODES=
# MONTHLY_QUESTION_LIMIT=30
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
